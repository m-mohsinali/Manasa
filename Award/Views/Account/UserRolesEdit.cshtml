@using Microsoft.Extensions.Localization
@model Award.Web.Models.UserRolesViewModel
@inject IStringLocalizer<Award.Web.Controllers.AccountController> _localizer
@inject Award.Web.Common.Auth.IUserSession _usersession


@{
    ViewData["Title"] = "UserRolesDetails";
}

<div>
    <h1 class="heading-border">@_localizer["User Roles Details"]</h1>
    <hr />

    <form asp-action="UserRolesEdit">
        <div class="">
            <div class="panel-body">
                <input type="hidden" asp-for="UserId" />

                <dl class="row row-direction">
                    <dt class="col-sm-2">
                        @_localizer["UserName"]
                    </dt>
                    <dd class="col-sm-10">
                        <h4>@Html.DisplayFor(model => model.UserName)</h4>
                    </dd>
                </dl>
                <dl class="row row-direction">
                    <dt class="col-sm-2">
                        @_localizer["Roles"]
                    </dt>
                    <dd class="col-sm-10">

                        @for (var i = 0; i < Model.AllRoles.Count; i++)
                        {
                            <p>
                                <input class="" type="checkbox" asp-for="@Model.AllRoles[i].IsSeleclted" />
                                <label asp-for="@Model.AllRoles[i].IsSeleclted">@Model.AllRoles[i].Name</label>
                                <input type="hidden" asp-for="@Model.AllRoles[i].Id" />
                                <input type="hidden" asp-for="@Model.AllRoles[i].Name" />
                            </p>
                        }

                    </dd>
                </dl>
            </div>
        </div>
        <input type="submit" value="@_localizer["Save"]" class="btn btn-default-custom" /> |
        <a asp-action="UserRoles" class="custom-link">@_localizer["Back to List"]</a>
    </form>

</div>

