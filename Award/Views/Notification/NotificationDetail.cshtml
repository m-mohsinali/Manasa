@model Award.Web.Models.NotificationViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment _hostEnv
@inject IStringLocalizer<Award.Web.Controllers.HomeController> _localizer
@inject Award.Web.Common.Auth.IUserSession _usersession

@{
    ViewData["Title"] = "Index";
}
<h1 class="heading-border">@_localizer["Notification"]</h1>
<hr />
<div class="">
    <div class="panel-body">

        <dl class="col-md-8">
            <dt class="col-sm-12">
                @_localizer["Type"]
            </dt>
            <dd class="col-sm-12">
                @Model.NotificationType
            </dd>
            <dt> &nbsp;</dt>
            <dd> </dd>
            <dt class="col-sm-12">
                @_localizer["CreatedDate"]
            </dt>
            <dd class="col-sm-12">
                @Model.Created
            </dd>
            <dt> &nbsp;</dt>
            <dd> </dd>
            <dt class="col-sm-12">
                @_localizer["Description"]
            </dt>
            <dd class="col-sm-12">
                @Model.NotificationText
            </dd>
            <dt> &nbsp;</dt>
            <dd> </dd>


        </dl>


    </div>
    <div class="form-group">
        <input action="action" onclick="window.history.go(-1); return false;" type="submit" class="btn btn-default-custom" value="@_localizer["Back"]" />
    </div>
</div>

