<div class="modal fade" id="showAnouncementmodal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">
                    &times;
                </button>
                <h4 class="modal-title">
                </h4>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>
                                    @*@Html.DisplayNameFor(model => model.Title)*@
                                    @_localizer["Title"]
                                </th>
                                <th>
                                    @*@Html.DisplayNameFor(model => model.Description)*@
                                    @_localizer["Description"]
                                </th>
                                <th>
                                    @*@Html.DisplayNameFor(model => model.StartAnnouncingDate)*@
                                    @_localizer["StartAnnouncingDate"]
                                </th>
                                <th>
                                    @*@Html.DisplayNameFor(model => model.EndAnnouncingDate)*@
                                    @_localizer["EndAnnouncingDate"]
                                </th>
                                @*<th>
                                        @Html.DisplayNameFor(model => model.CreatedAt)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.DeletedAt)
                                    </th>*@
                            </tr>
                        </thead>
                        <tbody id="tBodyAnnouncements">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script>


    //function showAnnouncementDetails(id) {
    //    alert(id);

    //}
    function showAnnouncementDetails(id) {

        $("#tBodyAnnouncements").empty();
        var url = "/Home/LoadAnnouncementDetail?id=" + escape(id);
        $.ajax({
            type: "Get",
            url: url,
            contentType: "application/json; charset=utf-8",
            success: function (result) {
                debugger;
                var data = result;
                var concept_list = '';

                for (var i = 0; i < data.result.length; i++) {
                    concept_list += '<tr>';
                    concept_list += '<td>' + data.result[i].name + '</td>';
                    concept_list += '<td>' + data.result[i].description + '</td>';
                    concept_list += '<td>' + data.result[i].startAnnouncingDate + '</td>';
                    concept_list += '<td>' + data.result[i].endAnnouncingDate + '</td>';
                    concept_list += '</tr>';
                }
                $('#tBodyAnnouncements').append(concept_list);
                $('#showAnouncementmodal').modal('show');
            },
            error: function (result) {
                alert(result.responseText);
            }
        });
    }
</script>