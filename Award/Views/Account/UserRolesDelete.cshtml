@using Microsoft.Extensions.Localization
@model Award.Web.Models.UserRolesViewModel
@inject IStringLocalizer<Award.Web.Controllers.AccountController> _localizer


@{
    ViewData["Title"] = "UserRolesDelete";
}

    <div>
        <h1 class="heading-border">@_localizer["User Roles Delete"]</h1>
        <hr />
        <div class="">
            <div class="panel-body">
                <dl class="row row-direction">
                    <dt class="col-sm-2">
                        @_localizer["UserName"]
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.UserName)
                    </dd>
                </dl>
                <dl class="row row-direction">
                    <dt class="col-sm-2">
                        @_localizer["Roles"]
                    </dt>
                    <dd class="col-sm-10">
                        @Html.DisplayFor(model => model.RolesNameList)
                    </dd>
                </dl>
            </div>
        </div>
    </div>
    <div>
        <form asp-action="UserRolesDelete">
            <input type="hidden" asp-for="UserId" />
            <input type="submit" value="@_localizer["Delete"]" class="btn btn-default-custom" /> |
            <a asp-action="UserRoles" class="custom-link">@_localizer["Back to List"]</a>
        </form>
    </div>
