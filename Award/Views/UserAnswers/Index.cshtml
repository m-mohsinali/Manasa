@model IEnumerable<Award.Web.Models.UserAnswersViewModel>
@*@using AwardContract.General
    @model IEnumerable<AwardContract.Models.Category>*@

@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment _hostEnv
@inject IStringLocalizer<Award.Web.Controllers.CategoriesController>  _localizer

@{
    
    //Layout = "~/Views/Shared/_Layout.cshtml";
}


    <div class="cointainer-fluid">
        <div class="row bg-title">
            <div class="col-lg-3 col-md-4 col-sm-4 col-xs-12">
            </div>
            <div class="col-lg-9 col-sm-8 col-md-8 col-xs-12">


            </div>
            <!-- /.col-lg-12 -->
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="white-box">

                    <h3 class="box-title m-b-0"> @_localizer["UserAnswers"]</h3>

                    @if (!string.IsNullOrEmpty(TempData["CategorySuccessMsg"]?.ToString()))
                    {
                        @TempData["CategorySuccessMsg"]
                        ;
                    }
                    <div class="table-responsive">
                        <table id="myTable" class="table table-striped">
                            <thead>
                                <tr>
                                    <th style="display:none"></th>
                                    <th>
                                        @*@Html.DisplayNameFor(model => model.Name)*@
                                        @_localizer["Categories"]
                                    </th>

                                    <th>
                                        @*@Html.DisplayNameFor(model => model.Award)*@
                                        @_localizer["Award"]
                                    </th>
                                    <th> @_localizer["Answer"]</th>

                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                <tr>
                                    <td style="display:none">
                                        @Html.DisplayFor(modelItem => item.QsmEntryId)
                                        @Html.DisplayFor(modelItem => item.CriteriaId)
                                        @Html.DisplayFor(modelItem => item.SubCriteriaId)


                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.CategoryName)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.AwardName)
                                    </td>
                                    <td><a href="#" id="@item.QsmEntryId" class="badge btn-danger" onclick="openAnswersPopUp(@item.QsmEntryId,@item.CriteriaId,@item.SubCriteriaId);"> @_localizer["Answer"]</a></td>

                                </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="container" id="divMessage" style="display:none">
                        <div class="alert btn-default-custom alert-dismissible">
                            <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                            <strong>Success!</strong> Sucessfully Saved!
                        </div>
                    </div>
                </div>
            </div>
        </div>
         
    </div>
<div class="modal fade" id="showAllocatemodal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">
                    &times;
                </button>
                <h4 class="modal-title">
                </h4>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table id="myTable" class="table table-striped">
                        <thead>
                            <tr>
                                <th style="display:none">
                                    @*@Html.DisplayNameFor(model => model.Name)*@
                                </th>
                                @if (ViewBag.Role == 3)
                                {
                                    <th>
                                        @*@Html.DisplayNameFor(model => model.Award)*@
                                        @_localizer["Answer"]
                                    </th>
                                }
                                 
                                    <th>
                                        @*@Html.DisplayNameFor(model => model.AwardType)*@
                                        @_localizer["Comments"]
                                    </th>
                                <th>
                                    Details
                                </th>

                                <th> @_localizer["Save"]</th>
                            </tr>
                        </thead>
                        <tbody>




                            <tr>
                                <td style="display:none;">
                                    @* @sector.Id*@
                                </td>
                                @if (ViewBag.Role == 3)
                                {
                                    <td>
                                        <input type="text" class="form-control" id="txtAnswer">
                                    </td>
                                }
                                    <td>
                                        <input type="text" class="form-control" id="txtComment">
                                    </td>
                                 
                                <td>
                                    <span id="commentsDetail"> </span>
                                    <table id="commentsDetailTable" class="table table-striped">
                                    </table>
                                </td>
                                <td>
                                    <a href="#" id="btnSave" class="btn btn-success" onclick="saveAnswer(1,@ViewBag.Role);"> @_localizer["Save"]</a>
                                    @if (ViewBag.Role == 2)
                                    {
                                        <a href="#" id="btnSubmit" class="btn btn-success" onclick="saveAnswer(2,@ViewBag.Role);"> @_localizer["Submit"]</a>
                                    }
                                    
                                </td>
                            </tr>

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
@section scripts{
    <script>
        var qsmId;
        var criteriaId;
        var subCriteriaId;

        function openAnswersPopUp(id,criteriaId,subCriteriaId) {
           // $('.alert').alert();
            qsmId = id;
            GetanswersDetails(qsmId,criteriaId,subCriteriaId);
            $('#showAllocatemodal').modal('show');
        }

        function saveAnswer(status,Role) {
            //   alert(a);
            //var str = $("#txtAnswer").val();
            //alert(str);
            if (Role == 3) {
             $.ajax({
                url: '@Url.Action("SaveAnswers","UserAnswers")',
                data: {
                    qsmId: qsmId,
                    criteriaId: criteriaId,
                    subCriteriaId:subCriteriaId,
                    answer:  $("#txtAnswer").val(),
                    comment: $("#txtComment").val(),
                    status:status
                    //sectorId: sectorId
                }
            }).done(function () {
                //alert('Added');
                 $('#showAllocatemodal').modal('hide');
                 var x = document.getElementById("divMessage");
                 x.style.display = "block";
            });
            }
            if (Role == 2) {

             $.ajax({
                url: '@Url.Action("SaveAnswersComments","UserAnswers")',
                data: {
                    qsmId: qsmId,
                    answer:  $("#txtAnswer").val(),
                    comment: $("#txtComment").val(),
                    status:status
                    //sectorId: sectorId
                }
             }).done(function () {
                 $('#showAllocatemodal').modal('hide');
                 var x = document.getElementById("divMessage");
                 x.style.display = "block";
               // alert('Added');
            });
            }
            //$('#showIntrestmodal').modal('show');
        }
        function GetanswersDetails(qsmId,criteriaId,subCriteriaId) {
            var Table = document.getElementById("commentsDetailTable");
            Table.innerHTML = "";
    debugger;
    $.ajax({
        type: "GET",
         url: '@Url.Action("GetanswersDetails","UserAnswers")',

        data: {
            qsmId: qsmId,
            criteriaId: criteriaId,
            subCriteriaId:subCriteriaId

        },
        contentType: "application/json",
        dataType: "json",
        success: function (result) {

            json = JSON.parse(result);

            $.each(json, function (index, value) {

                
                $('#commentsDetailTable').append('<tr><td> Answer: ' + value.Answer + '</td></tr> <tr><td> Comments: ' + value.Comments+'</td></tr>');
    });


        },
        error: function (response) {
            debugger;
            alert('eror');
        }
    });

}
    </script>
}
