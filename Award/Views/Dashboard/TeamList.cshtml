@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@model IEnumerable<Award.Core.Entities.Teams>
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment _hostEnv
@inject IStringLocalizer<Award.Web.Controllers.DashboardController> _localizer
@inject IStringLocalizer<Award.Web.Controllers.CategoriesController> _localizerCat

@{
    ViewData["Title"] = @_localizer["Teams"];
}

<h1 class="heading-border"> @_localizer["Teams"]</h1>
<hr />

<div class="table-responsive">
    <table id="myTable" class="table">
        <thead>
            <tr>

                <th>
                    @_localizer["Name"]
                </th>
                @*<th>
                    @_localizer["Members"]
                </th>*@

            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    @*<td>
                        @Html.DisplayFor(modelItem => item.EmployeeTeams.Count())
                    </td>*@
                </tr>
            }
        </tbody>
    </table>
</div>

