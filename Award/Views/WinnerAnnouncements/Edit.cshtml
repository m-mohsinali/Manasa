@model Award.Core.Entities.WinnerAnnouncement
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Award.Web.Controllers.HomeController> _localizer

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

}
<div class="container-fluid">
    <h1 class="heading-border">@_localizer["Edit Announcement"]</h1>
    <hr />
    <div class="panel-body">
        <form asp-action="Edit" class="form-horizontal form-bordered">
            <div class="row">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input id="hdnuserid" type="hidden" name="Userid" value="@Model.UserId" />
                <input id="hdnImagePath" type="hidden" name="ImagePath" value="@Model.ImagePath" />

                <div class="form-group">
                    <div class="row">
                        <div class="col-md-3">
                            <label class="control-label">@_localizer["User"]</label>
                            <input id="txtSearchEmployee" class="form-control" />
                        </div>
                        <div class="col-md-9"><button id="btnSearch" type="button" class="btn btn-danger"><i class="fa fa-check"></i> @_localizer["Search"]</button></div>
                    </div>
                </div>
                <div class="form-group">
                    <div class="row">
                        <div class="col-md-12">
                            <img id="imgEmployee" src="@Model.ImagePath" style="padding: 1rem; margin: auto; max-width: 150px; max-height: 150px;" />
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <div class="row">
                        <div class="col-md-4">
                            <label class="control-label">@_localizer["EmployeeName"]</label>
                            <input id="txtEmployeeName" class="form-control" value="@Model.User.Employee.NameAr" disabled />
                        </div>
                        <div class="col-md-4">
                            <label class="control-label">@_localizer["Year"]</label>
                            <select asp-for="@Model.AwardYear" asp-items="@ViewData["AwardYearSelectList"] as SelectList" class="form-control">
                                <option value="">@_localizer["Select"]</option>
                            </select>
                            <span asp-validation-for="@Model.AwardYear" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <div class="row">
                        <div class="col-md-4">
                            <label class="control-label">@_localizer["Award"]</label>
                            <select asp-for="@Model.AwardId" asp-items="@ViewData["AwardSelectList"] as SelectList" class="form-control">
                                <option value="">@_localizer["Select"]</option>
                            </select>
                            <span asp-validation-for="@Model.AwardId" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="control-label">@_localizer["Category"]</label>
                            <select asp-for="@Model.CategoryId" asp-items="@ViewData["CategoriesSelectList"] as SelectList" class="form-control">
                                <option value="">@_localizer["Select"]</option>
                            </select>
                            <span asp-validation-for="@Model.CategoryId" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <div class="row">
                        <div class="col-md-4">
                            <label class="control-label">@_localizer["Description"]</label>
                            <input asp-for="@Model.Description" class="form-control" rows="4" />
                            <span asp-validation-for="@Model.Description" class="text-danger"></span>
                        </div>
                    </div>

                </div>
                <div class="form-group">
                    <div class="checkbox">
                        <label>
                            <input asp-for="IsShow" /> @Html.DisplayNameFor(model => model.IsShow)
                        </label>
                    </div>
                </div>
                <input type="hidden" asp-for="Id" />
                @*<div class="form-group">
            <label asp-for="CreateDate" class="control-label"></label>
            <input asp-for="CreateDate" class="form-control" />
            <span asp-validation-for="CreateDate" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="UpdatedDate" class="control-label"></label>
            <input asp-for="UpdatedDate" class="form-control" />
            <span asp-validation-for="UpdatedDate" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="DeletedDate" class="control-label"></label>
            <input asp-for="DeletedDate" class="form-control" />
            <span asp-validation-for="DeletedDate" class="text-danger"></span>
        </div>*@
                <div class="form-group  row-direction">
                    <div class=" col-md-12">
                        <button type="submit" class="btn btn-default-custom"> <i class="fa fa-check"></i> @_localizer["Save"]</button>
                        <a asp-action="Index" class="btn btn-default">@_localizer["Cancel"]</a>

                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index" class="custom-link">@_localizer["Back to List"]</a>
</div>
<script>
    $(document).ready(function () {

        $('#btnSearch').click(function () {
                var searchtext = $('#txtSearchEmployee').val();
            $.getJSON('/WinnerAnnouncements/getEmployee?q=' + searchtext, function (data) {
                debugger;
                    if (data == null) {
                            $('#txtEmployeeName').val('N/A');
                        }
                    else {
                        $('#txtEmployeeName').val(data.name);
                        $('#hdnuserid').val(data.userId);
                        $('#imgEmployee').attr("src", data.employeeImageURL);
                        $('#hdnImagePath').val(data.employeeImageURL);

                        //alert(data);
                         //$('#spanNotificationCount').html(data);
                        }
                     });
        });

          });
</script>