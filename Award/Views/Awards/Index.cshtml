<div class="table-responsive">
    <table id="myTable" class="table table-condensed table-sm">
        <thead>
            <tr>
                <th>
                    @_localizer["awardImagePath"]
                </th>
                <th>
                    @_localizer["Name"]
                </th>
                <th>
                    @_localizer["Description"]
                </th>
                <th>
                    @_localizer["AwardStatus"]
                </th>
                <th>
                    @_localizer["OpeningDate"]
                </th>
                <th>
                    @_localizer["ClosingDate"]
                </th>
                <th style="min-width: 192px; text-align: center;">@_localizer["Manage"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <img style="max-width: 150px; max-height: 150px;" src="@item.AwardImagePath">
                    </td>
                    <td style="min-width: 150px !important;">
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Description)
                    </td>
                    <td>

                        @_localizer[@item.AwardStatus.ToString()]
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.OpeningDate)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ClosingDate)
                    </td>
                    <td>
                        @if (@_usersession.IsSuperAdmin)
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id"><i class="glyphicon glyphicon-edit text-success"></i> @_localizer["Edit"] | </a> 
                        }

                        <a asp-action="Details" asp-route-id="@item.Id"><i class="glyphicon glyphicon-list-alt text-info"></i> @_localizer["Details"]</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id"><i class="glyphicon glyphicon-remove text-danger"></i> @_localizer["Delete"]</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
