@model IEnumerable<Award.Web.Models.TeamMemberViewModel>
@*@using AwardContract.General
    @model IEnumerable<AwardContract.Models.Category>S
*@

@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment _hostEnv
@inject IStringLocalizer<Award.Web.Controllers.CategoriesController> _localizer
@inject IStringLocalizer<Award.Web.Controllers.HomeController> _localizerHome

@inject Award.Web.Common.Auth.IUserSession _usersession

@{
    //Layout = "~/Views/Shared/_Layout.cshtml";
}


<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<div class="cointainer-fluid">
    <div class="row bg-title">
        <div class="col-lg-3 col-md-4 col-sm-4 col-xs-12">
        </div>
        <div class="col-lg-9 col-sm-8 col-md-8 col-xs-12">


        </div>
        <!-- /.col-lg-12 -->
    </div>
    <div class="row">
        <div class="col-sm-12">
            <div class="white-box">

                <h1 class="heading-border"> @_localizer["Evaluation"]</h1>
                <hr />

                <div class="container" id="divMessage" style="display:none; width: 95%;">
                    <div class="alert btn-default-custom alert-dismissible">
                        <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                        Sucessfully Saved!
                    </div>
                </div>
                <div class="table-responsive">
                    <table id="myTable" class="table table-striped">
                        <thead>
                            <tr style="width: 100%;">
                                <th style="display:none">

                                </th>
                                <th>
                                    @_localizer["Award"]

                                </th>
                                <th>
                                    @_localizer["Categories"]

                                </th>
                                @if (!_usersession.IsJury && !_usersession.Isadmin)
                                {
                                <th>
                                    @_localizer["Name"]

                                </th>

                                <th>
                                    @_localizer["Status"]
                                </th>
                                }


                                @if (@_usersession.IsAuditManager)
                                {
                                <th> @_localizer["AllocateTeamLead"]</th>
                                }

                                @if (@_usersession.IsAuditor || @_usersession.IsJury || _usersession.Isadmin || @_usersession.IsAuditManager)
                                {
                                <th> @_localizer["View"]</th>
                                }
                                @if (@_usersession.IsAuditor)
                                {
                                <th> @_localizerHome["Schedule Meeting"]</th>

                                }
                                <th> @_localizer["Download"]</th>


                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {

                            <tr>
                                @*@if (!_usersession.IsJury)
                                    {
                                        <td style="display:none">
                                            @Html.DisplayFor(modelItem => item.UserId)
                                            @Html.DisplayFor(modelItem => item.CategoryTeamsId)


                                        </td>
                                    }*@
                                <td style="display:none">
                                    @Html.DisplayFor(modelItem => item.UserId)
                                    @Html.DisplayFor(modelItem => item.CategoryTeamsId)


                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Award)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.CatName)
                                </td>
                                @if (!_usersession.IsJury && !_usersession.Isadmin)
                                    {
                                <td>
                                    @Html.DisplayFor(modelItem => item.UserName)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Status)
                                </td>
                                    }


                                @if (@_usersession.IsAuditManager)
                                    {
                                <td><a href="#" id="@item.UserId" class="badge btn-danger" onclick="showTeamLead(@item.UserId,@item.CategoryTeamsId,'@item.CatName.ToString()','@item.Award.ToString()','@item.Status.ToString()');"> @_localizer["AllocateTeamLead"]</a></td>
                                    }

                                @if (@_usersession.IsAuditor || @_usersession.IsAuditManager)
                                    {
                                <td><a href="#" id="@item.UserId" class="badge btn-danger" onclick="ViewAllocatedCategory(@item.UserId,@item.CategoryTeamsId,'@item.Status',@item.AuditorId);"> @_localizer["View"]</a></td>
                                    }
                                @if (@_usersession.IsJury || _usersession.Isadmin)
                                    {
                                <td><a href="#" id="@item.CatId" class="badge btn-danger" onclick="ViewTopScorer(@item.CatId,@item.TeamId);"> @_localizer["View"]</a></td>
                                    }
                                @if (@_usersession.IsAuditor)
                                    {
                                <td><a href="#" id="@item.UserId" class="badge btn-danger" onclick="SendMeetingInvitation(@item.UserId);"> @_localizerHome["Schedule Meeting"]</a></td>
                                    }
                                <td>
                                    @Html.ActionLink(_localizer["Download"], "DownloadCategoryFiles", "Categories", new { catId = item.CatId }, new { @class = "badge btn-info" })
                                </td>
                            </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="showAllocatemodal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">
                    &times;
                </button>
                <h4 class="modal-title">
                </h4>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table id="myTable" class="table table-striped">
                        <thead>
                            <tr>
                                <th style="display:none">
                                    @_localizer["UserName"]
                                </th>
                                <th>
                                    @_localizer["Name"]
                                </th>
                                <th> @_localizer["AllocateTeamLead"]</th>
                            </tr>
                        </thead>
                        <tbody id="tBodyTeamLeads">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
@section scripts{
    <script>
                     $(document).ready(function () {

        if ('@ViewBag.saveStatus' == "1") {
            var x = document.getElementById("divMessage");
                 x.style.display = "block";
        }
        if ('@ViewBag.saveStatus' == "2") {
            alert("Not Added Successfully.");
        }
});

            var catId;
            function openAssignMemberPopUp(id) {
                   alert(id);
                catId = id;
                $('#showAllocatemodal').modal('show');
        }



         function showTeamLead(userId,catTeamId,cat,Award,status) {
             $("#loader").show();
                    $("#tBodyTeamLeads").empty();

                  //  catId = id;
            var url = "/Evaluation/ShowTeamLead?userId=" + escape(userId);
            url=url+"&catTeamId="+ escape(catTeamId);
                    $.ajax({
                             type: "Get",
                             url: url,
                        contentType: "application/json; charset=utf-8",
                        success: function (result) {
                            debugger;
                            var data = result;
                            var concept_list = '';
            for(var i=0;i<data.result.length;i++ ){
                            var disabled = "";

                 for (var j = 0; j < data.result.length; j++) {
                                     if (data.result[j].isSubmitted === true) {
                                         disabled = "disabled";
                                         break;
                                         }
                                }

                concept_list += '<tr>';
                concept_list += '<td>' + data.result[i].userName + '</td>';

                if (data.result[i].isSubmitted === true) {

                    var buttonLabel = '@_localizer["UnAllocate"]';
                    var btnClass = 'btn-default-custom';
                    disabled = "";
                }
                else {
                    var buttonLabel = '@_localizer["Allocate"]';
                    var btnClass = 'btn btn-secondary';
                }
                concept_list += '<td><button  type="button"'+ disabled+' class="btn '+btnClass+'" style=" width: 100px;" onclick="allocateTeamLead(' + data.result[i].userId+ ","+data.result[i].categoryTeamsId+","+"'"+Award+"'"+ "," +"'"+cat+"'"+ ')" >' + buttonLabel + '</button></td>';
                concept_list += '</tr>';
            }
                            $('#tBodyTeamLeads').append(concept_list);
                            $("#loader").hide();
                    $('#showAllocatemodal').modal('show');


         },
         error: function (result) {
             alert( result.responseText);
         }
     });

        }


        function allocateTeamLead(userId, catTeamId, cat, Award) {
                $.ajax({
                    url: '@Url.Action("AllocateTeamLead","Evaluation")',
                    data: {
                        userId: userId,
                        catTeamId: catTeamId,
                        cat: cat,
                        Award:Award
                    }
                }).done(function () {
                      $('#showAllocatemodal').modal('hide');
                 var x = document.getElementById("divMessage");
                 x.style.display = "block";
                });
        }

         function ViewAllocatedCategory(userId,catTeamId,Status,AuditorId) {


             var url = '@Url.Action("ViewAllocatedCategory", "Evaluation")';
                 url += "?userId=" + escape(userId);
                 url += "&catTeamId=" + escape(catTeamId);
                 url += "&auditorId=" + escape(AuditorId);
                 window.location.href = url;
        }

        function ViewTopScorer(catId,teamId) {
             var url = '@Url.Action("ViewTopScorer", "Evaluation")';
            url += "?catId=" + escape(catId);
             url += "&teamIdNew=" + escape(teamId);

             window.location.href = url;
        }

          function SendMeetingInvitation(userId) {
             var url = '@Url.Action("ShowMeetingInvitation", "Home")';
            url += "?userId=" + escape(userId);
             window.location.href = url;

        }
        function callUserAnswer() {
            window.location.href = '@Url.Content("~/UserAnswers/Index")';

        }

    </script>
}
