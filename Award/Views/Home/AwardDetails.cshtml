@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@model Award.Web.Models.AwardsViewModel
@inject IStringLocalizer<Award.Web.Controllers.HomeController> _localizer

@{
    ViewData["Title"] = "Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="row">
    <div class="col-md-12">
        <div class="thumbnail-winner-container thumbnail-winner-container_dashboard">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-2">
                    <img src="~/Image/award.png" style="max-height: 125px; max-width: 125px;" class="img-responsive" alt="@Model.award.Name" />
                </div>
                <div class="col-xs-12 col-sm-9 col-md-10">
                    <h2 class="font-weight-bold">@Model.award.Name</h2>
                    <div class="thumbTitle">
                        <small><i class="fa fa-calendar-o" aria-hidden="true"></i> @_localizer["Opening Date"]: @Model.award.OpeningDate , <i class="fa fa-calendar-o" aria-hidden="true"></i> @_localizer["Closing Date"] : @Model.award.ClosingDate</small>
                    </div>
                    <hr class="hr-custom" />

                    <div>
                        <a href="/home/DownloadAwardFiles?AwardId=@Model.award.Id" target="_blank" class="btn btn-default-custom"> @_localizer["Download"]</a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
<br />
@foreach (var cat in Model.Categories)
{
    <div class="row">
        <div class="col-md-12">
            <div class="thumbnail-winner-container thumbnail-winner-container_dashboard">
                <h4 class="font-weight-bold">
                    @cat.AwardType
                </h4>
                <div class="thumbTitle">
                    <small><i class="fa fa-calendar-o" aria-hidden="true"></i> @_localizer["Opening Date"]: @cat.OpeningDate , <i class="fa fa-calendar-o" aria-hidden="true"></i> @_localizer["Closing Date"]: @cat.ClosingDate</small>
                </div>
                <p>
                    @cat.Description
                </p>
                <div>
                    <a href="/home/DownloadCategoryFiles?categoryid=@cat.Id" target="_blank" class="btn btn-default-custom"> @_localizer["Download"]</a>
                </div>

            </div>
        </div>
    </div>


    @for (int i = 0; i < cat.CategoryCriteria.Count(); i++)
    {
        @*@if ((i % 2) == 0)
            {
                @Html.Raw("<hr /><div class='row'>")
            }*@
        <div class="row">

            @*<div class="col-xs-6">
                <div class="thumbnail-winner-container thumbnail-winner-container_dashboard">
                    <h4 class="">@cat.CategoryCriteria[i].Description</h4>

                    <div class="font-weight-bold">
                        sub category question sub category question
                    </div>
                    <div class="thumbTitle">
                        <small>Max Words : 15</small>
                        <small>, </small>
                        <small>Marks : 10</small>
                    </div>
                </div>
            </div>*@
            @foreach (var subcri in cat.CategoryCriteria[i].CategorySubCriteria)
            {
            <div class="col-xs-12">
                <div class="thumbnail-winner-container thumbnail-winner-container_dashboard">
                    <div class="font-weight-bold">
                        @subcri.Description
                    </div>
                    <div class="thumbTitle">
                        <small>@_localizer["Max Words"] : @subcri.MaxWords</small>
                        <small>@_localizer["Marks"] : @subcri.Marks</small>
                    </div>
                    <hr class="hr-custom" />
                </div>
            </div>
            }


        </div>

        @*@if ((i % 2) != 0 && i != 0)
            {
                @Html.Raw("</div>")
            }
