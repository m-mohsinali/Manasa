<!DOCTYPE html>
@*<html lang="en">*@

@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@inject IStringLocalizer<Award.Web.Controllers.HomeController> _localizer
@inject IStringLocalizer<Award.Web.Controllers.CategoriesController> _localizerCat

@inject Award.Web.Common.Auth.IUserSession _usersession
@*@inject Award.Web.Controllers.BaseController _baseController*@
@{ string lang = System.Threading.Thread.CurrentThread.CurrentCulture.ToString();
    var profilePic = @HttpContextAccessor.HttpContext.Session.GetString("empsig");
    var emproles = @HttpContextAccessor.HttpContext.Session.GetString("emproles");
    var curuserid = _usersession.Id;
}
<html>
<head>
    <title>@_localizer["General Directorate of Residency and Foreigners Affairs"]</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="~/lib/font-awesome-4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="~/lib//bootstrap-3.4.1/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/app.css" />
    <link href="~/css/evo-calendar.css" rel="stylesheet" />
    <link href="~/css/evo-calendar.midnight-blue.css" rel="stylesheet" />

    @if (lang.Contains("ar"))
    {
        <link rel="stylesheet" href="~/css/app-ar.css" />
