@model Award.Core.Entities.Contact
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment _hostEnv
@inject IStringLocalizer<Award.Web.Controllers.HomeController> _localizer

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

}

<div class="container-fluid">
    <h1 class="heading-border">@_localizer["Create Contacts"]</h1>
    <hr />
    <div class="panel panel-body">
        <div class="col-md-12">
            <form asp-controller="ContactUs" asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                <input id="hdnEmployeeNumber" type="hidden" name="EmployeeNumber" />

                <div class="form-group">
                    <div class="row">
                        <div class="col-md-3">
                            <label class="control-label">@_localizer["User"]</label>
                            <input id="txtSearchEmployee" class="form-control" />
                        </div>
                        <div class="col-md-9" style="margin-top: 2.5rem;"><button id="btnSearch" type="button" class="btn bg-pink pt-3"><i class="fa fa-check"></i> @_localizer["Search"]</button></div>
                    </div>
                </div>
                <div class="form-group">
                    <div class="row">
                        @if (string.IsNullOrEmpty(Model?.Photo))
                        {
                            <div class="col-md-12">
                                <img id="imgEmployee" src="~/Image/User image.png" style="padding: 1rem; margin: auto; width: 150px; height: 150px;" />
                            </div>
                        }
                        else
                        {
                            <div class="col-md-12">
                                <img id="imgEmployee" src="@Model.Photo" style="padding: 1rem; margin: auto; width: 150px; height: 150px;" />
                            </div>
                        }
                     
                    </div>
                </div>
                <div class="form-group">
                    <label class="control-label">@_localizer["Name (English)"]</label>
                    <input asp-for="EmployeeNameEn" class="form-control" />
                    <span asp-validation-for="EmployeeNameEn" class="text-danger"></span>
                    <input type="hidden" asp-for="Id" class="form-control" />
                    <input type="hidden" asp-for="Photo" class="form-control" />
                </div>
                <div class="form-group">
                    <label class="control-label">@_localizer["Name (Arabic)"]</label>
                    <input asp-for="EmployeeNameAr" class="form-control" />
                    <span asp-validation-for="EmployeeNameAr" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label class="control-label">@_localizer["Rank (English)"]</label>
                    <input asp-for="RankEn" class="form-control" />
                    <span asp-validation-for="RankEn" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label class="control-label">@_localizer["Rank (Arabic)"]</label>
                    <input asp-for="RankAr" class="form-control" />
                    <span asp-validation-for="RankAr" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label class="control-label">@_localizer["Job (English)"]</label>
                    <input asp-for="JobEn" class="form-control" />
                    <span asp-validation-for="JobEn" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label class="control-label">@_localizer["Job (Arabic)"]</label>
                    <input asp-for="JobAr" class="form-control" />
                    <span asp-validation-for="JobAr" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label class="control-label">@_localizer["Email"]</label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label class="control-label">@_localizer["Mobile"]</label>
                    <input asp-for="Mobile" class="form-control" />
                    <span asp-validation-for="Mobile" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label class="control-label">@_localizer["Phone"]</label>
                    <input asp-for="Phone" class="form-control" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
                <div class="form-group row-direction">
                    <div class=" ">
                        <button type="submit" class="btn btn-default-custom"> <i class="fa fa-check"></i> @_localizer["Create"]</button>
                        @*<button type="button" class="btn btn-default">@_localizer["Cancel"]</button>*@
                    </div>
                </div>
            </form>

            <div>
                <a asp-action="Show" class="custom-link">@_localizer["Back to List"]</a>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {

        $('#btnSearch').click(function () {
            var searchtext = $('#txtSearchEmployee').val();
            $('#hdnEmployeeNumber').val($('#txtSearchEmployee').val());
            $.getJSON('/WinnerAnnouncements/getEmployee?q=' + searchtext, function (data) {
                debugger;
                    if (data == null) {
                            $('#txtEmployeeName').val('N/A');
                        }
                    else {
                        $('#EmployeeNameEn').val(data.employeeNameEn);
                        $('#EmployeeNameAr').val(data.employeeNameAr);
                        $('#RankEn').val(data.rankEn);
                        $('#RankAr').val(data.rankAr);
                        $('#JobEn').val(data.jobEn);
                        $('#JobAr').val(data.jobAr);
                        $('#Email').val(data.email);
                        $('#imgEmployee').attr("src", data.employeeImageURL);
                        $('#Photo').val(data.employeeImageURL);
                        //alert(data.employeeImageURL);
                        }
                     });
        });

          });
</script>

