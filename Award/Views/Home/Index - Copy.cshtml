<!-- Start Thumbail Slider for Winner -->
<div class="banner-winner">
    <div class="container-fluid">
        <h1 class="text-center large-title text-white">@_localizer["Winner"]</h1>
        @*<p class=" text-white text-center">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor </p>*@
        <p class=" text-white text-center">@*@_localizer["Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor"]*@ </p>

        <div class="container-fluid" style="margin-top: 50px">
            <div id="mySliderWinner" class="carousel slide" data-ride="carousel">
                <!-- Indicators -->
                <ol class="carousel-indicators carousel-indicators-custom2">
                    <li data-target="#mySliderWinner" data-slide-to="0" class="active"></li>
                    <li data-target="#mySliderWinner" data-slide-to="1"></li>
                    <li data-target="#mySliderWinner" data-slide-to="2"></li>
                </ol>
                <!-- Wrapper for slides -->
                <div class="carousel-inner">

                    <div class="item active">
                        <div class="row">
                            @foreach (var winner in Model.AnnouncedWinners)
                            {

                                <div class="col-xs-4">
                                    <div class="thumbnail-winner-container" style="margin-top:10px; margin-bottom:10px;">
                                        <div class="row">
                                            <div class="col-xs-12 col-sm-4 col-md-3 py-2">
                                                @if (winner.ShowWinnerImage && winner.Category.AwardType != Award.Core.Entities.AwardType.Corporate)
                                                {
                                                    <img src="~/Image/thumb-winner.jpg">
                                                }
                                                else
                                                {
                                                    <img src="~/Image/thumb-winner.jpg">
                                                }
                                            </div>
                                            <div class="col-xs-12 col-sm-8 col-md-9 py-2">

                                                @if (winner.Category.AwardType == Award.Core.Entities.AwardType.Corporate)
                                                {
                                                    <div class="thumbTitle">
                                                        @winner.Sector.Name
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="thumbTitle">
                                                        @winner.Employee.NameEn
                                                    </div>
                                                }
                                            </div>
                                            <div class="font-weight-bold">@winner.Category.Name</div>
                                            <div>@winner.Category.Description</div>
                                            <a href="#" class="btn btn-default-custom mt-6">@_localizer["More"]</a>

                                            @*<div class="thumbTitle">@_localizer["John Dow2"]</div>
                                                <div class="font-weight-bold">@_localizer["Award Title"]</div>
                                                <div>@_localizer["Lorem ipsum dolor sit amet"]</div>
                                                <a href="#" class="btn btn-default-custom mt-6">@_localizer["More"]</a>*@
                                        </div>
                                    </div>
                                </div>


                            }
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>

    <!-- End of Winner Slider -->

</div>
