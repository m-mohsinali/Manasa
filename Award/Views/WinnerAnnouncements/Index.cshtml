@model IEnumerable<Award.Core.Entities.WinnerAnnouncement>
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Award.Web.Controllers.WinnersController> _localizer
@inject IStringLocalizer<Award.Web.Controllers.CategoriesController> _localizerCat


@{
    Layout = "~/Views/Shared/_Layout.cshtml";

}

@{
    ViewData["Title"] = "Index";
    //Layout = "~/Views/Shared/_AwardLayout.cshtml";
}
<div class="row justify-content-between">
    <div class="col-xs-6">
        <h1 class="heading-border">@_localizer["AnnouncementWinner"]</h1>
    </div>
    <div class="col-xs-6">
        <h1 class="text-right">
            <a asp-action="Create" class="btn btn-secondary">@_localizer["Create New Winner"]</a>
        </h1>
    </div>
</div>
<hr />


<div class="table-responsive">
    <table id="myTable" class="table">
        <thead>
            <tr>
                <th>
                    @_localizerCat["Award"]
                </th>
                <th>
                    @_localizerCat["Category"]
                </th>
                <th>
                    @_localizerCat["Name"]
                </th>
                <th>
                    @_localizerCat["Group"]
                </th>
                <th>
                    @_localizer["ShowWinnerImage"]
                </th>

                <th style="min-width: 192px; text-align: center;">@_localizer[""]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Awards.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Category.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.User.Employee.NameEn)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.User.Employee.Grp)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.IsShow)
                    </td>
                    @*<td>
                            @Html.DisplayFor(modelItem => item.CreatedAt)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.DeletedAt)
                        </td>*@
                    <td>
                        @if (@item.IsShow == false)
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id"><i class="glyphicon glyphicon-edit text-success"></i> @_localizer["Edit"]</a>
                        }
                        <a asp-action="Details" asp-route-id="@item.Id"><i class="glyphicon glyphicon-list-alt text-info"></i> @_localizer["Details"]</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id"><i class="glyphicon glyphicon-remove text-danger"></i> @_localizer["Delete"]</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>