</head>
<body style="background-image: url('../../image/new_back.jpeg'); background-position: center; background-size: cover;">

    <div id='loader' style='vertical-align: middle; width: 100%; height: 100%; top: 0; left: 0; position: fixed; display: block; opacity: 0.7; background-color: #fff; z-index: 9999;'>
        <img style="position: absolute; top: 35%; left:40%; z-index: 100;" src="~/Image/loader.gif" />
    </div>

    <div class="row topbar_admin justify-content-between" style="background-color: #ffffff99;">
        <div class="col-lg-3 col-md-3 col-sm-4 col-xs-12 ">
            <img src="~/Image/DNRD Logo.png" alt="Logo" class="img-responsive img-fluid" style="" />
        </div>
        <div class="col-lg-7 col-md-7 col-sm-5 col-xs-8 lang" style="padding-top: 3rem;">
            @await Html.PartialAsync("_SelectLanguagePartial")
        </div>
        <div class="col-lg-2 col-md-2 col-sm-3 col-xs-4 notif">
            <div class="dropdown" style="margin-top: 2rem; margin-right: 2rem; ">

                <a href="#" class="notification dropdown-toggle">
                    <span class="glyphicon glyphicon-bell" style="font-size: 5rem;"></span>
                    <span id="spanNotificationCount" class="badge">3</span>
                </a>
                <div id="divNotification" class="ShowNotification dropdown-menu " style="width: 20rem; max-height: 25rem; overflow-y: scroll; padding: 1rem;">
                    @*<div style="border-bottom: 1px solid lightgray; max-width: 5rem;">
                            <a style="text-decoration: none;" href="/Notification/NotificationDetail?NotificationId=notification['notificationId']"  >
                                <h4 style="display: block; overflow: hidden; text-overflow: ellipsis; line-height: 1;">Heading1</h4>
                                <p style="display: block; overflow: hidden; text-overflow: ellipsis; line-height: 1;">asdfasdf ads fadfsdasdfasfasdf asdfsa</p>
                            </a>
                        </div>
                        <div style="border-bottom: 1px solid lightgray; color: darkgray;">
                            <h4>Heading1</h4>
                            <p>asdfasdf ads fa dsf asd f</p>
                        </div>
                        <div style="border-bottom: 1px solid lightgray; color: darkgray;">
                            <h4>Heading1</h4>
                            <p>افضل قطاع في تطبيق في معيار تقديم الخدمات سبع نجوم	</p>
                        </div>*@
                </div>
            </div>


            <div class="dropdown" style="float: right;">
                <div class="user_profile dropdown-toggle" data-toggle="dropdown" style="direction: ltr;">
                    <img src="@profilePic">
                    @*<img src="~/Image/User image.png" style="margin-top: 0.5rem;">*@
                </div>
                <ul class="dropdown-menu lang-align" style="padding-bottom: 0;">
                    <li><a href="#">@_localizerCat[@emproles]</a></li>
                    <li><a asp-controller="Account" asp-action="Profile" asp-route-username="@User.Identity.Name">@_localizer["MyProfile"] (@User.Identity.Name)</a></li>
                    <li><a asp-controller="Account" asp-action="SwitchUser">@_localizer["SwitchUser"]</a></li>
                    @*<li><a href="#">@_localizer["Setting"]</a></li>*@

                    <li>
                        <form class="form-inline" method="post" asp-controller="Account" asp-action="Signout">
                            <input type="submit" class="btn btn-default-custom btn-block rounded-0" style=" border-radius: 0;" value="@_localizer["Logout"]" />
                        </form>
                    </li>
                </ul>

            </div>

        </div>
    </div>


    <div class="wrapper">

        <div id="sidebar" class="sidebar">
            <a id="home" asp-controller="Home" asp-action="Opening"><i class="fa fa-fw fa-home"></i>&nbsp;@_localizer["Home"]</a>
            @if (@_usersession.Isadmin || _usersession.IsAuditor || _usersession.IsSuperAdmin)
            {
                <a id="dashboard" asp-controller="Dashboard" asp-action="Index"><i class="fa fa-trophy" aria-hidden="true"></i>&nbsp;@_localizer["Dashboard"]</a>

            }
            @if (@_usersession.Isadmin || _usersession.IsSuperAdmin)
            {
                <a id="award" asp-controller="Awards" asp-action="Index"><i class="fa fa-trophy" aria-hidden="true"></i>&nbsp;@_localizer["Awards"]</a>
                <a id="cat" asp-controller="Categories" asp-action="Index"><i class="fa fa-th" aria-hidden="true"></i>&nbsp;@_localizer["Categories"]</a>
                <a href="#" class="current"><i class="fa fa-bell" aria-hidden="true"></i>&nbsp;@_localizer["Announcement"]</a>
                <ul class="dropdown-menu lang-align" style="border-radius: 0; padding-top: 0; padding-bottom: 0; margin-top: 0; border-top: 2px solid #808080; border-bottom: 4px solid #808080">
                    <li> <a asp-controller="Announcement" asp-action="Index"><i class="fa fa-bell" aria-hidden="true"></i>&nbsp;@_localizer["Announcement"]</a></li>
                    <li>  <a asp-controller="AnnouncementHome" asp-action="Index"><i class="fa fa-volume-up" aria-hidden="true"></i>&nbsp;@_localizer["AnnouncementHome"]</a></li>
                    <li> <a asp-controller="VideosHome" asp-action="Index"><i class="fa fa-video-camera" aria-hidden="true"></i>&nbsp;@_localizer["VideosHome"]</a></li>
                    <li> <a asp-controller="WinnerAnnouncements" asp-action="Index"><i class="fa fa-bullhorn" aria-hidden="true"></i>&nbsp;@_localizer["AnnouncementWinner"]</a></li>

                </ul>
                @*<a href="#event"><i class="fa fa-calendar-o" aria-hidden="true"></i>&nbsp;@_localizer["Event"]</a>*@
                <a asp-controller="Account" asp-action="UserRoles"><i class="fa fa-user-o" aria-hidden="true"></i>&nbsp;@_localizer["User"]</a>
                <a asp-controller="EmployeesTeam" asp-action="Index"><i class="fa fa-users" aria-hidden="true"></i>&nbsp;@_localizer["Team"]</a>
                <a asp-controller="JuryTeams" asp-action="Index"><i class="fa fa-balance-scale" aria-hidden="true"></i>&nbsp;@_localizer["Jury"]</a>

                <a asp-controller="Sector" asp-action="Index"><i class="fa fa-building" aria-hidden="true"></i>&nbsp;@_localizer["Sector"]</a>
                @*<a href="#evaluations"><i class="fa fa-bandcamp" aria-hidden="true"></i>&nbsp;@_localizer["Evaluations"]</a>*@
                @*<a href="#settings"><i class="fa fa-cog fa-fw" aria-hidden="true"></i>&nbsp;@_localizer["Settings"]</a>*@
                <a asp-controller="ContactUs" asp-action="Show"><i class="fa fa-id-card-o" aria-hidden="true"></i> &nbsp;@_localizer["Create Contacts"]</a>

            }
            @if (@_usersession.IsQSM || @_usersession.IsEndUser)
            {
                <a id="categories" asp-controller="Categories" asp-action="Index"><i class="fa fa-th" aria-hidden="true"></i>&nbsp;@_localizer["Categories"]</a>
            }
            @if (@_usersession.IsAuditManager || @_usersession.IsAuditor || @_usersession.IsJury || @_usersession.Isadmin || _usersession.IsSuperAdmin)
            {
                <a asp-controller="Evaluation" asp-action="Index"><i class="fa fa-gavel" aria-hidden="true"></i>&nbsp;@_localizer["Evaluations"]</a>
            }
            @if (@_usersession.Isadmin || _usersession.IsSuperAdmin)
            {
                <a asp-controller="Reports" asp-action="Index"><i class="fa fa-file-o" aria-hidden="true"></i>&nbsp;@_localizer["Reports"]</a>

            }
            @*@if (@_usersession.IsJury)
            {
                <a asp-controller="JuryOperations" asp-action="Index"><i class="fa fa-video-camera" aria-hidden="true"></i>&nbsp;@_localizer["AnnouncementWinner"]</a>

        }*@

            <a asp-controller="Forum" asp-action="Index"><i class="fa fa-clipboard" aria-hidden="true"></i>&nbsp;@_localizer["CommonQuestions"]</a>
            <a asp-controller="Notification" asp-action="Index"><i class="fa fa-bell" aria-hidden="true"></i>&nbsp;@_localizer["Notification"]</a>
            <a asp-controller="Notification" asp-action="Calendar"><i class="fa fa-calendar-check-o" aria-hidden="true"></i>&nbsp;@_localizer["Calendar"]</a>
            <a asp-controller="ContactUs" asp-action="Index"><i class="fa fa-id-card-o" aria-hidden="true"></i>&nbsp;@_localizer["Contacts"]</a>

        </div>
        <div id="wrapper" class="content">
            @RenderBody()
            <!-- end bottom slider-->
            <!--start footer -->
            <div class="footer-container">
                <p>@_localizer["2020 © All Rights Reserved."]</p>
            </div>
            <!-- end footer-->
        </div>

    </div>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/jquery.dataTables.min.js"></script>
    @RenderSection("Scripts", required: false)
    <script>
        $(document).ready(function () {
            $('#loader').hide();
            $('#sidebarCollapse').on('click', function () {
                $('#sidebar').toggleClass('active');
                $(this).toggleClass('active');
            });
        });
    </script>
    <script>
        $(document).ready(function () {
            $('.dropdown-toggle').dropdown()
        });
    </script>

    <script>
        $('.sidebar .current').on('click', function () {
            //$(this).addClass('current').siblings('a').removeClass('current');;
            $(this).next('.dropdown-menu').slideToggle();
            $(this).siblings('a').next('.dropdown-menu').slideUp();
        });
    </script>

    <script>
        jQuery(function ($) {
            var path = window.location; // because the 'href' property of the DOM element is the absolute path
            $('.sidebar a').filter(function () {
                return this.href == path || path.href.indexOf(this.href) == 0;
            }).addClass('active').parent().addClass('in').parent();
        });
    </script>

    <script>
        $(document).ready(function () {
            //$('#myTable').DataTable();
            var searchText = '@_localizer["Search"]';
            $('#myTable').DataTable({
            "stateSave": true,
            "oLanguage": {
                sSearch: '@_localizer["Search"]',
                sInfo: '@_localizer["sInfo"]',
                sLengthMenu: '@_localizer["sLengthMenu"]',
                sInfoEmpty: '@_localizer["sInfoEmpty"]',
                oPaginate:{sFirst:'@_localizer["First"]',sLast:'@_localizer["Last"]',
                    sNext: '@_localizer["Next"]', sPrevious: '@_localizer["Previous"]',
                    sInfoFiltered:"("+'@_localizer["sInfoFiltered"]'+")"
                },
                sEmptyTable: '@_localizer["sEmptyTable"]'
            }
            });

            $(".notification").click(function(){
            $(".ShowNotification").toggle();
            });


            $.getJSON('/Notification/GetNotificationList', function (data) {
                 var items = '';
                $.each(data, function (i, notification) {
                    if (notification["isRead"] == true) {
                        items += "<div style='border-bottom: 1px solid lightgray; max-width: 18rem;'>  <a style='text-decoration: none;'  href='/Notification/NotificationDetail?NotificationId="+notification["notificationId"]+"'  > <b> <h4 style='display: block; overflow: hidden; text-overflow: ellipsis; line-height: 1;'>" + notification["notificationType"] + "</h4> </b><p  style='display: block; overflow: hidden; text-overflow: ellipsis; line-height: 1;'>" + notification["notificationText"] + "</p> </a> </div>";
                    }
                    else {
                        items += "<div style='border-bottom: 1px solid lightgray; color: darkgray; max-width: 18rem;'> <a style='text-decoration: none;' href='/Notification/NotificationDetail?NotificationId="+notification["notificationId"]+"'  > <h4 style='display: block; overflow: hidden; text-overflow: ellipsis; line-height: 1;'>" + notification["notificationType"] + "</h4><p style='display: block; overflow: hidden; text-overflow: ellipsis; line-height: 1;'>" + notification["notificationText"] + "</p></a></div>";
                    }
                 });
                 $('#divNotification').html(items);
            });


            $.getJSON('/Notification/UnReadNotification', function (data) {
                if (data == 0) {
                    $('#spanNotificationCount').hide();
                }
                else {
                 $('#spanNotificationCount').html(data);
                }
             });



        });
    </script>

</body>
</html>