@model IEnumerable<Award.Web.Models.ForumTopicsViewModel>

@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment _hostEnv
@inject IStringLocalizer<Award.Web.Controllers.HomeController> _localizer
@inject Award.Web.Common.Auth.IUserSession _usersession

@{
    ViewData["Title"] = "CommonQuestionDetail";
}

<div class="row justify-content-between">
    <div class="col-xs-6">
        <h1 class="heading-border"> @_localizer["CommonQuestionDetail"]</h1>
    </div>
    <div class="col-xs-6">
        <h1 class="text-right">
            @*<a asp-action="Create">Create Award</a>*@
           
                @if (ViewData["CategoryName"] !=null)
                {
                   @ViewData["CategoryName"].ToString();
                 
                }
            
        </h1>
    </div>
</div>

<hr />
<div class="table-responsive">
    <table id="myTable" class="table table-condensed table-sm">
        <thead>
            <tr>
                <th>
                    @_localizer["Topics"]
                </th>
                <th>
                    @_localizer["Reply"]
                </th>

                <th ></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <b>@item.ForumTopic</b>
                        <div class="row">
                            <div class="col-md-6"> @_localizer["Created"]:  @item.CreatedDate</div>
                            <div class="col-md-6"> @_localizer["User"]:  @item.UserName</div>
                        </div>
                    </td>
                    <td>
                        @item.TotalReply
                        @*@Html.DisplayFor(modelItem => item.AwardType)*@
                    </td>
                    <td>
                        <a asp-controller="Forum" asp-action="ForumTopicsReply" asp-route-ForumId="@item.ForumId"><i class="glyphicon glyphicon-list-alt text-info"></i> @_localizer["Details"]</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<hr />
<div class="panel-body">
    <form asp-controller="Forum" asp-action="CreateForumTopics" method="post" enctype="multipart/form-data">

        <div class="row">
            <div class="col-md-12 form-group">
                @*<label asp-for="award.Description" class="control-label"></label>*@
                <label class="control-label">@_localizer["Create Topic"]</label>
                <textarea name="ForumText" class="form-control" rows="3"></textarea>
            </div>
        </div>
        @if (ViewData["CategoryId"] != null)
        {
            <input type="hidden" name="CategoryId" value="@ViewData["CategoryId"]" />
        }

    <div class="row">
        <div class="col-sm-1 form-group">
            <a asp-action="Publish"><input type="submit" value="@_localizer["Publish"]" class="btn btn-default-custom" /></a>
        </div>
        <div class="col-sm-1 form-group">
            <input action="action" onclick="window.history.go(-1); return false;" type="submit" class="btn btn-default-custom" value="@_localizer["Back"]" />
        </div>
    </div>
    </form>
</div>


