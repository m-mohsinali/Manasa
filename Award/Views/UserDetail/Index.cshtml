@using Award.Core.Entities
@model Award.Web.Models.CommonLookUp
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment _hostEnv
@inject IStringLocalizer<Award.Web.Controllers.CategoriesController> _localizer
@inject IStringLocalizer<Award.Web.Controllers.AccountController> _localizerAccount
@inject IStringLocalizer<Award.Web.Controllers.SectorController> _localizerSector
@inject IStringLocalizer<Award.Web.Controllers.HomeController> _localizerHome




@{
    ViewData["Title"] = @_localizer["Create"];
    //Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .b {
        border-radius: 25px;
        padding-top: 0px;
        padding-bottom: 0px;
    }
    .check {
        display: inline;
        width: 100px;
        height: 100px;
    }
    #checkbox input[type=checkbox] {
        display: none;
    }

        #checkbox input[type=checkbox]:checked + .check {
            background-color: lightgray;
        }
</style>


<h1 class="heading-border">@_localizer["Category"]</h1>
<hr />
<div class="cointainer-fluid">
    <div class="row bg-title">
        <div class="col-lg-3 col-md-4 col-sm-4 col-xs-12">
        </div>
        <div class="col-lg-9 col-sm-8 col-md-8 col-xs-12">


        </div>
        <!-- /.col-lg-12 -->
    </div>

    @*//Change Color*@
    <div class="row" style="margin-left:5px; margin-right:5px;">
        <div class="col-md-12">
            <div class="white-box">
                <div class="row">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <form asp-action="Create">
                        <input type="hidden" name="hiddenCategory" id="hiddenCategory" value="@Model.CategoryId" />
                        <div>
                            <div class="container" id="divMessage" style="display:none">
                                <div class="alert btn-default-custom alert-dismissible">
                                    <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                                      Sucessfully Processed!
                                </div>
                            </div>
                            <div class="table-responsive">
                                <table id="myTable" class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th style="display:none;"> </th>
                                            <th>
                                                @_localizer["Name"]
                                            </th>
                                            <th>
                                                @_localizer["NameArabic"]
                                            </th>
                                            <th>
                                                @_localizerAccount["Sector Name"]
                                            </th>
                                            <th>
                                                @_localizerAccount["Department Name"]

                                            </th>
                                            @*<th>
                                                @_localizerAccount["Section Name"]
                                            </th>
                                            <th>
                                                @_localizerAccount["Branch Name"]
                                            </th>
                                            <th>
                                                @_localizerAccount["Unit Name"]
                                            </th>
                                            <th>
                                                @_localizer["Rank"]
                                            </th>*@
                                            <th id="checkbox" class="text-center" style="display: normal; cursor: default">
                                                @**@<label class="check" for="checkheader" style="cursor: pointer">@_localizerSector["Assign"]</label><INPUT id="checkheader" type="checkbox" onchange="checkAll(this)" name="chk[]" />
                                            </th>
                                            <th>
                                                @_localizer["Action"]
                                            </th>
                                            @*<th>
                                                @_localizerHome["Schedule Evaluation"]
                                            </th>*@

                                        </tr>
                                    </thead>
                                    <tbody>
                                        @*@foreach (var item in Model.userDetail)*@

                                        @for (int i = 0; i < Model.userDetail.Count(); i++)

                                        {
                                            <tr>
                                                <td style="display:none;">
                                                    @Html.HiddenFor(modelItem => Model.userDetail[i].EmployeeId)
                                                    @Html.HiddenFor(modelItem => Model.CategoryId)
                                                    @Html.HiddenFor(modelItem => Model.selectedSectorId)


                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelitem => Model.userDetail[i].EmployeeNameEn)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelitem => Model.userDetail[i].EmployeeNameAr)

                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelitem => Model.userDetail[i].Sector)

                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelitem => Model.userDetail[i].Department)

                                                </td>
                                                @*<td>
                                                    @Html.DisplayFor(modelitem => Model.userDetail[i].Section)

                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelitem => Model.userDetail[i].Branch)

                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelitem => Model.userDetail[i].Unit)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelitem => Model.userDetail[i].Rank)
                                                </td>*@
                                                <td class="text-center">
                                                    @if (Model.userDetail[i].qsmEntryStatus == 4)
                                                    {
                                                        @Html.CheckBoxFor(m => Model.userDetail[i].IsAssigned, new { @disabled = "disabled", @onclick="AssignButton('"+Model.userDetail[i].EmployeeId+"');" })

                                                    }
                                                    else
                                                    {
                                                        @Html.CheckBoxFor(m => Model.userDetail[i].IsAssigned, new {  @onclick="AssignButton('"+i+"','"+Model.userDetail[i].UserId+"','"+Model.CategoryId+"');" })
                                                    }
                                                </td>

                                                <td>
                                                    @if (@Model.userDetail[i].CurrentStatus == "View")
                                                    {
                                                    <a href="#" id="@Model.CategoryId" class="btn b btn-warning" onclick="javascript:return false;" > @_localizer["UnAssigned"]</a>

                                                    @*@Html.ActionLink(_localizer["View"], "Index", "UserDetail", new { catId = @Model.CategoryId }, new { @class = "badge badge-danger", onclick = "javascript:return false;" })*@

                                                    }
                                                    else if (@Model.userDetail[i].CurrentStatus == "Waiting For Response")
                                                    {
                                                    <a href="#" id="@Model.CategoryId" class="btn b btn-info" onclick="openAssignMemberPopUp(@Model.CategoryId,@Model.userDetail[i].UserId);"> @_localizer["Waiting For Response"]</a>

                                                    }
                                                    else if (@Model.userDetail[i].CurrentStatus == "Submitted")
                                                    {
                                                    <a href="#" id="@Model.CategoryId" class="btn b btn-danger" onclick="openAssignMemberPopUp(@Model.CategoryId,@Model.userDetail[i].UserId);"> @_localizer["Submitted"]</a>

                                                    }
                                                     else if (@Model.userDetail[i].CurrentStatus == "Assigned")
                                                    {
                                                    <a href="#" id="@Model.CategoryId" class="btn b btn-primary" onclick="openAssignMemberPopUp(@Model.CategoryId,@Model.userDetail[i].UserId);"> @_localizer["Assigned"]</a>

                                                    }

                                                    
                                                    else
                                                    {

                                                    <a href="#" id="@Model.CategoryId" class="btn b btn-success" onclick="openAssignMemberPopUp(@Model.CategoryId,@Model.userDetail[i].UserId);"> @_localizer["AcceptandForward"]</a>

                                                    }



                                                </td>
                                                @*<td>
                                                    <a href="#" id="@Model.CategoryId" class="btn b btn-success" onclick="SendMeetingInvitation(@Model.userDetail[i].UserId);">  @_localizerHome["Schedule Meeting"]</a>
                                                </td>
                                                <td>
                                                    <a href="#" id="@Model.CategoryId" class="badge badge-success" onclick="SendMeetingInvitation(@Model.userDetail[i].UserId);">  @_localizerHome["Schedule Meeting"]</a>

                                                </td>*@

                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-1 form-group">
                                <button id="btnAssign" type="submit" class="btn btn-default-custom" disabled>@_localizer["Save"]</button>
                            </div>
                            <div class="col-sm-1 form-group">
                                <input action="action" onclick="window.history.go(-1); return false;" type="submit" class="btn btn-default-custom" value="@_localizer["Back"]" />
                            </div>

                        </div>
                    </form>
                    <input type="hidden" id="totalCriteria" value="0" />
                </div>
            </div>
        </div>
    </div>



</div>
@section Scripts {

    <script type="text/javascript">
        function AssignButton(loopId, empId, categoryId) {

            var actionTaken = "";
            var checkBoxelement = $('#userDetail_' + loopId + '__IsAssigned')
            if ($(checkBoxelement).is(':not(:checked)')) {
                actionTaken = "uncheck";
            }
            else {
               actionTaken ="check"
            }

             $.getJSON('/UserDetail/CheckIfAssignButtonShouldHide?catId=' + categoryId+'&empUserId='+empId+'&actionTaken='+actionTaken, function (data) {
                 debugger;
                 if (data != null) {
                                    
                                 if (data == true) {
                                     $('#btnAssign').prop("disabled", true);
                                 }
                                 else {
                                     $('#btnAssign').prop("disabled", false);
                                 }
                       }
                     });
              
        }

        function AssignButtonStatus() {

             $('#'+pID).find(':checkbox').each(function(){
                    jQuery(this).attr('checked', $('#' + id).is(':checked'));
              });  
        }
        function checkAll(ele) {
                 $('#btnAssign').prop("disabled", false);

             var checkboxes = document.getElementsByTagName('input');
             if (ele.checked) {
                 for (var i = 0; i < checkboxes.length; i++) {
                     if (checkboxes[i].type == 'checkbox') {
                         checkboxes[i].checked = true;
                     }
                 }

                 //$('#btnAssign').prop("disabled", false);


             } else {
                 for (var i = 0; i < checkboxes.length; i++) {
                     console.log(i)
                     if (checkboxes[i].type == 'checkbox') {
                         checkboxes[i].checked = false;
                     }
                 }
                 //$('#btnAssign').prop("disabled", true);

             }
        }

           function openAssignMemberPopUp(id,assignedUserId) {
                //$('#showAllocatemodal').modal('show');
                //call Assign Members here
           var url = "?catId=" + escape(id);
               url=url+"&assignedUserId="+escape(assignedUserId);
            window.location.href = '@Url.Content("~/Categories/FillCriteria")'+url;

            }
        showMessage();
    function showMessage() {
         if (@Model.saveStatus == 1)
             {
          $('#showAllocatemodal').modal('hide');
                 var x = document.getElementById("divMessage");
                 x.style.display = "block";
        }
    }

    function filter(id,fieldName) {
        var url = '@Url.Action("Index", "UserDetail")';
        if (fieldName == 'Sector') {
            url += "?sectorId=" + escape(id);
            alert(url);
            objHiddenSector.value = id;
        }
        if (fieldName == 'Department') {
            url += "?deptId=" + escape(id);
            objHiddenDepartment.value = id;

        }
        if (fieldName == 'Section') {
            url += "?sectionId=" + escape(id);
            objHiddenSection.value = id;

        }
        if (fieldName == 'Branch') {
            url += "?branchId=" + escape(id);
            objHiddenBranch.value = id;

        }
        if (fieldName == 'Unit') {
            url += "?unitId=" + escape(id);
            objHiddenUnit.value = id;

        }
       // alert(document.getElementById("hiddenCategory").value);
        //url += "&catId=" + escape(document.getElementById("hiddenCategory").value);
        //alert(url);
        window.location.href = url;

    }
         function SendMeetingInvitation(userId) {
             var url = '@Url.Action("ShowMeetingInvitation", "Home")';
            url += "?userId=" + escape(userId);
             window.location.href = url;

        }
    </script>

    <script>
        $(document).ready(function () {
            //$('.sidebar a').click(function () {
            $('a#categories').addClass("active");
            //$(this).addClass("active");
            //});
        });
    </script>
}
