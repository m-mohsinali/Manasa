@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@model IEnumerable<Award.Web.Models.AwardsViewModel>
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment _hostEnv
@inject IStringLocalizer<Award.Web.Controllers.DashboardController> _localizer
@inject IStringLocalizer<Award.Web.Controllers.CategoriesController> _localizerCat

@{
    ViewData["Title"] = @_localizer["AwardsIndex"];
}

<h1 class="heading-border"> @_localizer["AwardsTitle"]</h1>
<hr />

<div class="table-responsive">
    <table id="myTable" class="table">
        <thead>
            <tr>
                <th>
                    @_localizer["awardImagePath"]
                </th>
                <th>
                    @_localizer["Name"]
                </th>
                <th>
                    @_localizer["Description"]
                </th>
                <th>
                    @_localizer["AwardStatus"]
                </th>
                <th>
                    @_localizer["OpeningDate"]
                </th>
                <th>
                    @_localizer["ClosingDate"]
                </th>

                <th style="min-width: 170px !important;" hidden> </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <img src="~/@item.award.AwardImagePath" style="max-width: 150px; max-height: 150px;">
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.award.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.award.Description)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.award.AwardStatus)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.award.OpeningDate)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.award.ClosingDate)
                    </td>
                    <td hidden>
                        <a asp-action="Edit" asp-route-id="@item.award.Id"><i class="glyphicon glyphicon-edit text-success"></i> @_localizer["Edit"]</a> |
                        <a asp-action="Details" asp-route-id="@item.award.Id"><i class="glyphicon glyphicon-list-alt text-info"></i>@_localizer["Details"]</a> |
                        <a asp-action="Delete" asp-route-id="@item.award.Id"><i class="glyphicon glyphicon-remove text-danger"></i>@_localizer["Delete"]</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

