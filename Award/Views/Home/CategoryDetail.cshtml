@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@model Award.Web.Models.AwardsViewModel
@inject IStringLocalizer<Award.Web.Controllers.HomeController> _localizer

@{
    ViewData["Title"] = "Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
var mediaType = Model.MediaType;
}

<div class="row">
    <div class="col-xs-12">
        <div class="thumbnail-winner-container thumbnail-winner-container_dashboard">
            <div class="row">
                <div class="col-xs-12 col-sm-3 col-md-2">
                    <img src="~/Image/award.png" class="img-responsive" alt="@Model.award.Name" />
                </div>
                <div class="col-xs-12 col-sm-9 col-md-10">
                    <h2 class="font-weight-bold">@Model.award.Name</h2>
                    <div class="thumbTitle">
                        <small><i class="fa fa-calendar-o" aria-hidden="true"></i> @_localizer["Opening Date"]: @Model.award.OpeningDate , <i class="fa fa-calendar-o" aria-hidden="true"></i> @_localizer["Closing Date"] : @Model.award.ClosingDate</small>
                    </div>
                    <hr class="hr-custom" />
                    <h4 class="font-weight-bold">
                        @Model.category.AwardType
                    </h4>
                    <div class="thumbTitle">
                        <small><i class="fa fa-calendar-o" aria-hidden="true"></i> @_localizer["Opening Date"]: @Model.category.OpeningDate , <i class="fa fa-calendar-o" aria-hidden="true"></i> @_localizer["Closing Date"]: @Model.category.ClosingDate</small>
                    </div>
                    <p>
                        @Model.category.Description
                    </p>
                    <div>
                        @*<a asp-action="DownloadCategoryFiles" target="_blank" class="btn btn-default-custom"> @_localizer["Download"]</a>*@
                        <a href="/home/DownloadCategoryFiles?categoryid=@Model.category.Id" target="_blank" class="btn btn-default-custom"> @_localizer["Download"]</a>

                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
@for (int i = 0; i < Model.category.CategoryCriteria.Count(); i++)
{
    @if ((i % 2) == 0)
    {
        @Html.Raw("<hr /><div class='row'>")
    }
    <div class="col-xs-6">
        <div class="thumbnail-winner-container thumbnail-winner-container_dashboard">
            <div class="row">
                <div class="col-xs-12">
                    <h4 class="">@Model.category.CategoryCriteria[i].Description</h4>

                    

                    @foreach (var subcri in Model.category.CategoryCriteria[i].CategorySubCriteria)
                    {
                        <hr class="hr-custom" />
                        <div class="font-weight-bold">
                            @subcri.Description
                        </div>
                        <div class="thumbTitle">
                            <small>@_localizer["Max Words"] : @subcri.MaxWords</small>
                            <small>@_localizer["Marks"] : @subcri.Marks</small>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>


    @if ((i % 2) != 0 && i != 0)
    {
        @Html.Raw("</div>")
    }
    @*if (i == (Model.category.CategoryCriteria.Count() - 1) && (i % 2) != 0)
    {
        <div class="col-xs-6"></div>
        <br />
    }*@
 }

@if(mediaType=="Print")
{
<script>
    $('.sidebar').hide();
     $('.topbar_admin').hide();
</script>
}








