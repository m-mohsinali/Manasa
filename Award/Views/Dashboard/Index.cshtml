    .hexagon {
        position: relative;
        display: block;
        overflow: hidden;
        width: 140px;
        height: 140px;
        margin: 0 auto;
        transform: rotate(240deg);
    }

    .hex-wrapper {
        position: absolute;
        display: block;
        overflow: hidden;
        width: 100%;
        height: 100%;
        transform: rotate(60deg);
    }

    .hex-border {
        position: absolute;
        display: block;
        overflow: hidden;
        width: 100%;
        height: 100%;
        transform: rotate(60deg);
    }

    .hex-border:hover {
        box-shadow: 0 0 10px rgba(0, 0, 0, 1) ;
    }

    .hex-border:before {
        content: "\0020";
        position: absolute;
        display: block;
        width: 100%;
        height: 100%;
        transform: rotate(60deg);
    }

    .hex-border:after {
        content: "\0020";
        position: absolute;
        display: block;
        width: 100%;
        height: 100%;
        transform: rotate(120deg);
    }

