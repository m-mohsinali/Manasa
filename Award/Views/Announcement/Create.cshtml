@model Award.Models.AnnouncementViewModel
@using Microsoft.Extensions.Localization
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment _hostEnv
@inject IStringLocalizer<Award.Web.Controllers.AnnouncementController> _localizer
@using Microsoft.AspNetCore.Mvc.Localization

@*@{
        ViewData["Title"] = "Create";
        Layout = "~/Views/Shared/_AwardLayout.cshtml";
    }*@
    <div id="page-wrapper">
        <!-- END HEADER.PHP PART-->

        <h1 class="heading-border">
            @_localizer["Create Announcement"]
        </h1>
        <hr />
        <div class="panel-body">
            <div class="col-md-12">
                <form asp-action="Create" enctype="multipart/form-data" class="form-horizontal form-bordered">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group col-md-12 row-direction">
                        <label class=" col-md-12">@_localizer["Title"]</label>
                        <div class="col-md-12">
                            <input type="text" asp-for="Announcement.Title" placeholder="Enter Announcement Title" class="form-control">
                            <span asp-validation-for="Announcement.Title" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group col-md-12 row-direction">
                        <label class=" col-md-12">@_localizer["StartAnnouncingDate"]</label>
                        <div class="col-md-12">
                            <div class="col-md-12 input-group">
                                <input type="datetime-local" asp-for="Announcement.StartAnnouncingDate" class="form-control mydatepicker"> @*<span class="input-group-addon"><i class="fa fa-calendar"></i></span>*@
                                <span asp-validation-for="Announcement.StartAnnouncingDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group col-md-12 row-direction">
                        <label class=" col-md-12">@_localizer["EndAnnouncingDate"]</label>
                        <div class="col-md-12">
                            <div class="col-md-12 input-group">
                                <input type="datetime-local" asp-for="Announcement.EndAnnouncingDate" class="form-control mydatepicker">  @*<span class="input-group-addon"><i class="fa fa-calendar"></i></span>*@
                                <span asp-validation-for="Announcement.EndAnnouncingDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group col-md-12 row-direction">
                        <label class=" col-md-12">@_localizer["Description"]</label>
                        <div class="col-md-12">
                            <textarea id="mymce" class="form-control" asp-for="Announcement.Description" rows="3"></textarea>
                            <span asp-validation-for="Announcement.Description" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group col-md-12 row-direction">
                        <label asp-for="ThumbnailImage" class=" col-md-12">@_localizer["Add Image"]</label>
                        <div class="col-md-12">
                            <input asp-for="ThumbnailImage" class="form-control" type="file" />
                            <span asp-validation-for="ThumbnailImage" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group col-md-12 row-direction">
                        <div class=" col-md-12">
                            <button type="submit" class="btn btn-default-custom"> <i class="fa fa-check"></i> @_localizer["Save"]</button>
                            <button type="button" class="btn btn-default">@_localizer["Cancel"]</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

<!-- /.START FOOTER.PHP -->
