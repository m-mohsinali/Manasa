        </dd>*@
            <dt class="col-sm-12">
                @*@Html.DisplayNameFor(model => model.OpeningDate)*@
                @_localizer["OpeningDate"]
            </dt>
            <dd class="col-sm-12">
                <input type="datetime-local" id="txtStartDate" asp-for="@Model.OpeningDate" class="form-control mydatepicker" placeholder="yyyy-mm-dd hh:ii" readonly> 

            </dd>
            <dt> &nbsp;</dt>
            <dd> </dd>
            <dt class="col-sm-12">
                @*@Html.DisplayNameFor(model => model.ClosingDate)*@
                @_localizer["ClosingDate"]
