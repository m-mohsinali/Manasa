@using Microsoft.Extensions.Localization
@model Award.Web.Models.TeamViewModel
@inject IStringLocalizer<Award.Web.Controllers.TeamController> _localizer
@inject IStringLocalizer<Award.Web.Controllers.CategoriesController> _localizerCat

@{
    ViewData["Title"] = "Create Jury";
}

<div>
    <h1 class="heading-border">@_localizer["Create Jury"]</h1>
    <hr />
    <form asp-action="Create">
        <input type="hidden" asp-for="TeamId" />
        <input type="hidden" asp-for="CategoryId" />
        <div class="row" style="margin-bottom:10px;">
            <div class="form-group row-direction">
                <div class="col-sm-2">
                    <label class="control-label">@_localizerCat["Jury"]</label>
                </div>
                <div class="col-sm-10">

                    @for (var i = 0; i < @Model.JuryUserList.Count; i++)
                    {
                        <span>
                            @{
                                var chkBoxJury = "chkBoxJury" + @Model.JuryUserList[i].UserId;

                            }
                            <input type="checkbox" id="@chkBoxJury" class="checkbox" asp-for="@Model.JuryUserList[i].IsSelected" style="display: inline-block" />
                            <label asp-for="@Model.JuryUserList[i].IsSelected">@Model.JuryUserList[i].UserName</label>
                            <input type="hidden" asp-for="@Model.JuryUserList[i].UserId" />
                            <input type="hidden" asp-for="@Model.JuryUserList[i].UserName" />
                        </span>
                    }
                </div>
            </div>
        </div>
        <input type="submit" value="@_localizer["Create"]" class="btn btn-default-custom" id="btnSubmit" /> |
        <a asp-action="Index" class="custom-link">@_localizer["Back to List"]</a>
    </form>
</div>


<div class="modal fade" id="showMessagemodal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">
                    &times;
                </button>
                <h4 class="modal-title">
                </h4>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>
                                    <b>@_localizer["Alert"]</b>
                                </th>

                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <span id="msgAlert">

                                    </span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
