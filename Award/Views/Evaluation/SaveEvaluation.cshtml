@model List<Award.Web.Models.AuditingUserAnswerViewModel>
@*@using AwardContract.General
    @model IEnumerable<AwardContract.Models.Category>S
*@

@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment _hostEnv
@inject IStringLocalizer<Award.Web.Controllers.CategoriesController> _localizer
@inject Award.Web.Common.Auth.IUserSession _usersession

@{
    //Layout = "~/Views/Shared/_Layout.cshtml";

}


<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    @*<!--<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">
        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.4.1/jquery.min.js"></script>
        <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>-->*@
</head>
<div class="cointainer-fluid">
    <h1 class="heading-border"> @_localizer["Evaluation"]</h1>
    <hr />

    <div class="container" id="divMessage" style="display:none">
        <div class="alert btn-default-custom alert-dismissible">
            <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
            <strong>Success!</strong> Sucessfully Assigned!
        </div>
    </div>

    <div class="row bg-title">
        <div class="col-lg-3 col-md-4 col-sm-4 col-xs-12">
        </div>
        <div class="col-lg-9 col-sm-8 col-md-8 col-xs-12">


        </div>
        <!-- /.col-lg-12 -->
    </div>
    <form asp-action="SaveAuditingUserAnswer">
        <div class="row">
            <div class="col-sm-12">
                <div class="white-box">

                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>
                                        @_localizer["Criteria"]

                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>

                                    <td>
                                        @Html.DisplayFor(modelItem => Model[0].Criteria)
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="table-responsive">
                        <table id="myTable" class="table table-striped">
                            <thead>
                                <tr>
                                    <th style="display:none">

                                    </th>

                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Count(); i++)
                                {

                                    <tr style="width: 100%;">
                                        <th style="width: 30%;">
                                            @_localizer["Sub Criteria"]
                                        </th>
                                        <th style="width: 10%;" class="text-center">
                                            @_localizer["MaxMarks"]
                                        </th>
                                        <th style="width: 35%;" class="text-center">
                                            @_localizer["Answer"]

                                        </th>
                                        <th style="width: 10%;">
                                            @_localizer["Marks"]
                                        </th>
                                        <th style="width: 5%;" class="text-center">
                                            @_localizer["Documents"]
                                        </th>
                                    </tr>
                                    <tr>
                                        <td style="display:none">
                                            @Html.HiddenFor(modelItem => Model[i].SubCriteriaId)
                                            @Html.HiddenFor(modelItem => Model[i].TeamEntryId)
                                            @Html.HiddenFor(modelItem => Model[i].CatId)
                                            @Html.HiddenFor(modelItem => Model[i].UserAnswerId)

                                        </td>
                                        <td style="width: 30%;">
                                            @Html.DisplayFor(modelItem => Model[i].Description)
                                        </td>
                                        <td style="width: 10%;" class="text-center">
                                            @Html.DisplayFor(modelItem => Model[i].MaxMarks)
                                        </td>
                                        <td style="width: 35%;">
                                            @Html.DisplayFor(modelItem => Model[i].Answer)
                                        </td>
                                        <td style="width: 10%;">
                                            @if (_usersession.Isadmin || _usersession.IsAuditManager)
                                            {
                                                <input type="number" min="0" class="form-control" asp-for="@Model[i].Marks" onblur="marksCheck(this.value, @Model[i].MaxMarks);" disabled />
                                            }
                                            else
                                            {
                                                <input type="number" min="0" class="form-control" asp-for="@Model[i].Marks" onblur="marksCheck(this.value, @Model[i].MaxMarks);" />
                                            }

                                        </td>
                                        <td style="width: 5%;">
                                            @*<a href="~/@Model[i].Document1" download="Document2">Document1</a>*@

                                            @Html.ActionLink(_localizer["Download"], "DownloadSubCriteriaFiles", "UserDetail", new { subCriteria = Model[i].SubCriteriaId, qsmEntryId = Model[i].QsmEntryId }, new { @class = "badge btn-info" })

                                            @*<a href="~/@Model[i].Document2" download="Document2">Document2</a>*@

                                        </td>
                                    </tr>
                                    <tr style="width:100%">
                                        <th colspan="2" style="background-color: #999; text-align: center;">
                                            @_localizer["Strengths"]
                                        </th>
                                        <th colspan="3" style="background-color: #999; text-align: center;">
                                            @_localizer["Improvements"]
                                        </th>

                                    </tr>
                                    <tr style="width:100%">
                                        <td colspan="2">
                                            @if (_usersession.Isadmin || _usersession.IsAuditManager)
                                            {
                                                <textarea type="text" class="form-control" asp-for="@Model[i].Strength" disabled></textarea>
                                            }
                                            else
                                            {
                                                <textarea type="text" class="form-control" asp-for="@Model[i].Strength"></textarea>
                                            }

                                        </td>
                                        <td colspan="3">
                                            @if (_usersession.Isadmin || _usersession.IsAuditManager)
                                            {
                                                <textarea type="text" class="form-control" asp-for="@Model[i].Suggestion" disabled></textarea>
                                            }
                                            else
                                            {
                                                <textarea type="text" class="form-control" asp-for="@Model[i].Suggestion"></textarea>
                                            }

                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @*@if (_usersession.IsJury)
                    {
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>
                                            @_localizer["Comments"]

                                        </th>
                                        <th>
                                            @_localizer["Total Marks"]

                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>

                                        <td>
                                            <textarea type="text" class="form-control" asp-for="@Model[0].Suggestion"></textarea>

                                        </td>
                                        <td>
                                            <input type="text" id="totalMarks" class="form-control" asp-for="@Model[0].Suggestion"></input>

                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    }*@



                </div>
            </div>
        </div>
        @if (!_usersession.Isadmin && !_usersession.IsAuditManager)
        {
            <div class="form-group">
                <input type="submit" value="@_localizer["Save"]" class="btn btn-success" id="btnSave" /><br />
            </div>
        }
    <div class="form-group">
        <input action="action" onclick="window.history.go(-1); return false;"type="submit" class="btn btn-default-custom" value="@_localizer["Back"]" />

    </div>
    </form>


</div>
<div class="modal fade" id="showAllocatemodal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">
                    &times;
                </button>
                <h4 class="modal-title">
                </h4>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table id="myTable" class="table table-striped">
                        <thead>
                            <tr>
                                <th style="display:none">
                                    @_localizer["UserName"]

                                </th>

                                <th>
                                    @*@Html.DisplayNameFor(model => model.Award)*@
                                    @_localizer["UserName"]
                                </th>
                                <th>
                                    @*@Html.DisplayNameFor(model => model.AwardType)*@
                                    @_localizer["Name"]
                                </th>



                                @if (@_usersession.IsAuditManager)
                                {
                                    <th> @_localizer["AssignMember"]</th>
                                }
                                @if (@_usersession.IsAuditManager)
                                {
                                    <th> @_localizer["AssignMember"]</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @*@foreach (var user in ViewBag.Users)
                                {
                                    <tr>
                                        <td style="display:none;">
                                            @user.Id
                                        </td>
                                        <td>
                                            @user.UserName
                                        </td>
                                        <td>
                                            @user.FirstName
                                        </td>

                                        <td><a href="#" id="@user.Id" class="btn btn-success" onclick="assignMember(@user.Id);"> @_localizer["AssignMember"]</a></td>

                                    </tr>
                                }*@

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
@section scripts{
    <script>

        function marksCheck(givenMarks,maxMarks) {
            if (givenMarks > maxMarks) {

                alert("Marks should be less than Max Marks!");
                document.getElementById("btnSave").disabled = true;

            }
            else {
                document.getElementById("btnSave").disabled = false;
            }
            

        }

            var catId;
            function openAssignMemberPopUp(id) {
                catId = id;
                $('#showAllocatemodal').modal('show');
            }

            function allocateTeamLead(userId,catTeamId) {

                $.ajax({
                    url: '@Url.Action("AllocateTeamLead","Evaluation")',
                    data: {
                        userId: userId,
                        catTeamId:catTeamId
                    }
                }).done(function () {
                      $('#showAllocatemodal').modal('hide');
                 var x = document.getElementById("divMessage");
                 x.style.display = "block";
                });
        }

         function ViewAllocatedCategory(userId,catTeamId) {

                $.ajax({
                    url: '@Url.Action("ViewAllocatedCategory","Evaluation")',
                    data: {
                        userId: userId,
                        catTeamId:catTeamId
                    }
                }).done(function () {
                      $('#showAllocatemodal').modal('hide');
                 var x = document.getElementById("divMessage");
                 x.style.display = "block";
                   // alert('Added');
                });
                //$('#showIntrestmodal').modal('show');
        }

        function callUserAnswer() {
            window.location.href = '@Url.Content("~/UserAnswers/Index")';

        }

    </script>
}
