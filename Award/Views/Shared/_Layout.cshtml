    <style>
        .topbar_admin > .center .Langdropdown {
            @*width: 165px;*@
            margin: 0 10px;
        }

        .topbar_admin {
            padding: 10px 0;
        }

        .notification {
            color: #555555;
            text-decoration: none;
            //background-color: #555;
            //color: white;
            //text-decoration: none;
            //padding: 15px 26px;
            //width: 18rem;
            //position: relative;
            //border-radius: 2px;
        }

        .notification:hover {
            //background: darkred;
        }

        .notification .badge {
            position: absolute;
            top: -10px;
            right: -10px;
            padding: 5px 10px;
            border-radius: 50%;
            background: darkred;
            color: white;
        }

        .notif_back {
            width: 30rem;
            padding: 3rem;
            color: #ffffff;
