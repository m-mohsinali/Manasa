            <dd class="col-sm-12">
                <input type="datetime-local" id="txtStartDate" asp-for="@Model.ClosingDate" class="form-control mydatepicker" placeholder="yyyy-mm-dd hh:ii" readonly> 

            </dd>
            <dt> &nbsp;</dt>
            <dd> </dd>
            @*<dt>
            @Html.DisplayNameFor(model => model.CreateDate)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.CreateDate)
            <hr />
        </dd>*@
        <dt class="col-sm-12">
             
            @_localizer["SupportingDocument"]


        </dt>
            <dd class="col-sm-12">
                @foreach (var v in Model.CategoryDocuments)
                {
                    <b> <a href='~/@v.SupportingDocumentPath' target="_blank" download>@v.DocumentName</a> </b>
                }
            </dd>

        </dl>
        <dl class="col-md-6">
            <dt class="col-sm-12">
                @_localizer["Criteria"]
            </dt>

            <dd class="col-sm-12">
                @**@
                @if (Model.CategoryCriteria != null && Model.CategoryCriteria.Count > 0)
                {
                    foreach (var categoryCriteria in Model.CategoryCriteria)
                    {
                        <div class="table-responsive">
                            <table id="myTable" class="table table-striped">
                                <thead>
                                    <tr>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><strong>@_localizer["Criteria"]:</strong></td>
                                    </tr>
                                    <tr>
                                        <td>
                                            @categoryCriteria.Description
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><strong>@_localizer["Sub Criteria"]:</strong></td>
                                    </tr>
                                    <tr>
                                        <td>
                                            @if (categoryCriteria.CategorySubCriteria != null && categoryCriteria.CategorySubCriteria.Count > 0)
                                            {
                                                <table class="table table-striped">
                                                    <thead>
                                                        <tr style="text-align: center;">
                                                            <th> @_localizer["Description"]</th>
                                                            <th> @_localizer["TotalMarks"]</th>
                                                            <th> @_localizer["Total Words"]</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var subCriteria in categoryCriteria.CategorySubCriteria)
                                                        {
                                                            <tr>
                                                                <td class="lang-align">@subCriteria.Description</td>
                                                                <td>@subCriteria.Marks</td>
                                                                <td>@subCriteria.MaxWords</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            }
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    }
                }
                @*</dd>*@
            </dd>
        </dl>

            

    </div>
    
</div>
